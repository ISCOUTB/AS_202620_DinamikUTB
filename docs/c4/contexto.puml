@startuml DinamikUTB_Contexto

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title DinamikUTB — C4 Nivel 1: Contexto
caption Diagrama de contexto del sistema — Agosto 2026

Person(estudiante, "Estudiante", "Consulta su progreso de graduación, requisitos pendientes, historial y envía solicitudes.")
Person(coordinador, "Coordinador académico", "Consulta estudiantes de sus programas, atiende solicitudes y actualiza información autorizada.")
Person(administrador, "Administrador", "Administra usuarios, programas, requisitos y la configuración general del sistema.")

System(dinamik, "DinamikUTB", "Sistema para el seguimiento de los requisitos necesarios para la graduación universitaria.")

Rel(estudiante, dinamik, "Consulta su progreso y envía solicitudes", "HTTPS/JSON")
Rel(coordinador, dinamik, "Consulta y actualiza información autorizada", "HTTPS/JSON")
Rel(administrador, dinamik, "Administra usuarios, programas y requisitos", "HTTPS/JSON")

SHOW_LEGEND()

@enduml
