# Copiar a .env solo para desarrollo local. .env NO se versiona (.gitignore).
# En Render, DATABASE_URL la inyecta la base gestionada (ver render.yaml).

# Local: SQLite. Desplegado: cadena de conexión de Render Postgres.
DATABASE_URL=sqlite:///./dinamikutb.db

# Orígenes permitidos por CORS, separados por comas (solo esquema+host).
CORS_ORIGINS=https://iscoutb.github.io
