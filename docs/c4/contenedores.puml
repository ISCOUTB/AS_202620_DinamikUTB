@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title DinamikUTB — C4 Nivel 2: Contenedores
caption Diagrama de contenedores del sistema — Octubre 2026 (S12: almacenes de datos)

Person(estudiante, "Estudiante", "Consulta su progreso de graduación, requisitos pendientes, historial y envía solicitudes.")
Person(coordinador, "Coordinador académico", "Consulta estudiantes de sus programas, atiende solicitudes y actualiza información autorizada.")
Person(administrador, "Administrador", "Administra usuarios, programas, requisitos y la configuración general del sistema.")

System_Boundary(dinamik, "DinamikUTB") {
    Container(frontend, "Frontend Flutter", "Flutter / Dart", "Interfaz de usuario multiplataforma. Desplegado como sitio estático en GitHub Pages (ADR-0006). Conserva en memoria el estado de sus pantallas (ver arc42 §8.9).")
    ContainerDb(token_store, "Almacén de sesión del cliente", "flutter_secure_storage (almacenamiento del navegador)", "Guarda el token JWT de acceso (30 min). Es una copia local: el servidor revalida al usuario en cada petición.")
    Container(backend, "Backend API", "FastAPI / Python", "API principal. Módulos con código: usuarios, estudiantes y requisitos (programas y ayuda, pendientes). Desplegado en Render Free Web Service (ADR-0005). Mantiene en memoria el limitador de login y las métricas (volátiles, se pierden con el spin down).")
    ContainerDb(database_local, "Base de datos (desarrollo local y CI)", "SQLite", "Tablas: usuarios, estudiantes, requisitos, requisitos_historial. Se usa cuando DATABASE_URL no está definida (ADR-0003).")
    ContainerDb(database_prod, "Base de datos (ambiente desplegado)", "PostgreSQL — Render Postgres Free", "Mismas tablas. Fuente de verdad del ambiente desplegado; el historial de cambios vive aquí (ADR-0007, ADR-0011). Expira a los 30 días.")
    ContainerDb(logs, "Registro operativo", "Logs JSON por stdout (logs de Render)", "Una línea por petición y por cambio de estado. Telemetría, no fuente de verdad ni registro de auditoría (ADR-0011).")
}

Rel(estudiante, frontend, "Interactúa con la interfaz")
Rel(coordinador, frontend, "Interactúa con la interfaz")
Rel(administrador, frontend, "Interactúa con la interfaz")
Rel(frontend, token_store, "Lee y escribe el token", "API de almacenamiento del navegador")
Rel(frontend, backend, "Consume la API", "HTTP/JSON (síncrono, ADR-0004)")
Rel(backend, database_local, "Lee y escribe (local/CI)", "SQL, vía SQLAlchemy (ORM)")
Rel(backend, database_prod, "Lee y escribe (desplegado)", "SQL, vía SQLAlchemy (ORM) + psycopg")
Rel(backend, logs, "Escribe", "stdout, JSON")

footer Sin broker de mensajería: la comunicación es síncrona (ADR-0004) y no se extrae ningún módulo (ADR-0010).

SHOW_LEGEND()
@enduml
