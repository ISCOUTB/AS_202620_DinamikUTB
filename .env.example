# Copia este archivo como .env para desarrollo local. Git ignora el archivo .env.
# No subas credenciales reales al repositorio. Configura los secretos de producción
# en Render; render.yaml genera los valores marcados con generateValue.

# Valores permitidos: development, test o production. Producción exige una configuración segura.
APP_ENV=development

# URL de PostgreSQL local. Render proporciona la URL de la base administrada.
DATABASE_URL=postgresql://dinamik:cambia-esta-clave@localhost:5432/dinamikutb

# Credenciales que docker-compose.yml usa para el contenedor local de PostgreSQL.
POSTGRES_USER=dinamik
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=dinamikutb

# Clave de firma JWT de al menos 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Orígenes CORS separados por comas; incluye el esquema y el host, sin rutas ni '*'.
CORS_ORIGINS=https://iscoutb.github.io

# Opcional. GET /metrics requiere el valor configurado en la cabecera de autenticación.
# En producción, la ruta queda deshabilitada si no se configura.
METRICS_TOKEN=

# Opcional. Con al menos 12 caracteres, python -m app.seed crea los usuarios demo
# estudiante.demo@dinamikutb.dev y coordinador.demo@dinamikutb.dev.
SEED_DEMO_PASSWORD=
