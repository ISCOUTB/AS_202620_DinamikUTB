@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title DinamikUTB — C4 Nivel 2: Contenedores
caption Diagrama de contenedores del sistema — Noviembre 2026

Person(estudiante, "Estudiante", "Consulta su progreso de graduación, requisitos pendientes, historial y envía solicitudes.")
Person(coordinador, "Coordinador académico", "Consulta estudiantes de sus programas, atiende solicitudes y actualiza información autorizada.")
Person(administrador, "Administrador", "Administra usuarios, programas, requisitos y la configuración general del sistema.")

System_Boundary(dinamik, "DinamikUTB") {
    Container(token_store, "Almacén de sesión del cliente", "flutter_secure_storage (navegador)", "Guarda el token JWT de acceso (30 min).")

    Container(proxy, "Proxy inverso (laboratorio)", "Traefik, gestionado por Dokploy", "Enruta el tráfico público hacia la web y la API.")
    Container(web_lab, "Frontend Web (laboratorio)", "Nginx en Docker (GHCR)", "Sirve la SPA estática de Flutter compilada con API_BASE_URL.")

    Container(backend_lab, "Backend API (laboratorio)", "FastAPI / Python en Docker", "Módulos: usuarios, estudiantes, requisitos, programas, curriculo y reportes. Desplegado con deploy/compose.lab.yaml. Límite: 0,5 CPU y 192 MB (ADR-0012).")
    ContainerDb(database_lab, "Base de datos (laboratorio)", "PostgreSQL 16 en Docker, volumen pgdata", "Tablas: usuarios, password_reset_tokens, estudiantes, estudiantes_historial, requisitos, requisitos_historial, programas, planes_estudio, cursos, curso_prerrequisitos. Límite: 0,5 CPU y 160 MB (ADR-0011, ADR-0012).")

    ContainerDb(database_local, "Base de datos local y CI", "SQLite", "Mismas tablas para desarrollo y suite Pytest (ADR-0003).")
    ContainerDb(logs, "Registro operativo", "Logs JSON por stdout", "Telemetría operativa estructurada (ADR-0011).")
}

System_Ext(smtp, "Servidor SMTP", "Servidor de correo saliente para restablecimiento de contraseñas.")

Rel(estudiante, proxy, "Accede a la interfaz", "HTTPS")
Rel(coordinador, proxy, "Accede a la interfaz", "HTTPS")
Rel(administrador, proxy, "Accede a la interfaz", "HTTPS")

Rel(proxy, web_lab, "Enruta estáticos", "HTTP:80")
Rel(web_lab, token_store, "Lee/escribe token", "API de navegador")
Rel(proxy, backend_lab, "Enruta llamadas API", "HTTP:8000")

Rel(web_lab, backend_lab, "Consume API vía proxy", "JSON / HTTPS síncrono (ADR-0004)")
Rel(backend_lab, database_lab, "Persiste y audita", "SQL vía SQLAlchemy + psycopg")
Rel(backend_lab, smtp, "Envía correo de recuperación", "SMTP / TLS (mejor esfuerzo)")
Rel(backend_lab, logs, "Emite telemetría", "stdout, JSON")

footer Integración síncrona (ADR-0004), sin broker de eventos (arc42 §8.10). Ambiente Render retirado tras vencimiento de base (ADR-0012).
SHOW_LEGEND()
@enduml
