@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70

title DinamikUTB — C4 Nivel 3: Componentes del Backend

Container_Ext(web, "Frontend Web", "Flutter / GitHub Page", "SPA del usuario.")

Container_Boundary(backend, "Backend API (FastAPI)") {

    ' --- Capa 1: entrada ---
    Component(app, "main.py", "FastAPI", "Routers, CORS, cabeceras de seguridad, /health y /metrics.")

    ' --- Capa 2: dominio académico ---
    Component(requisitos, "requisitos/", "Módulo", "Estado, avance y catálogo de requisitos.")
    Component(curriculo, "curriculo/", "Módulo", "Malla y progreso por curso.")

    ' --- Capa 3: soporte al dominio ---
    Component(programas, "programas/", "Módulo", "Programas académicos.")
    Component(estudiantes, "estudiantes/", "Módulo", "Perfil académico e historial.")
    Component(ayuda, "ayuda/", "Módulo", "Solicitudes por programa.")
    Component(reportes, "reportes/", "Módulo", "Exportación CSV.")

    ' --- Capa 4: núcleo compartido ---
    Component(usuarios, "usuarios/", "Módulo", "Login JWT, roles y RBAC.")
    Component(core, "core/", "Módulo", "Config, BD, seguridad, métricas, logging.")
}

ContainerDb(bd, "Base de datos", "PostgreSQL 16 / SQLite", "Datos e historiales.")

' ---------- Posición en cuadrícula ----------
Lay_D(web, app)
Lay_D(app, requisitos)
Lay_R(requisitos, curriculo)
Lay_D(requisitos, programas)
Lay_R(programas, estudiantes)
Lay_R(estudiantes, ayuda)
Lay_R(ayuda, reportes)
Lay_D(estudiantes, usuarios)
Lay_D(usuarios, core)
Lay_D(core, bd)

' ---------- Relaciones ----------
Rel_D(web, app, "Consume", "JSON / HTTPS")
Rel_D(app, requisitos, "Enruta")
Rel_D(app, curriculo, "Enruta")
Rel_D(app, reportes, "Enruta")

Rel_R(requisitos, curriculo, "Pide créditos")
Rel_D(curriculo, estudiantes, "Consulta")
Rel_R(programas, estudiantes, "Renombre masivo", "")
Rel_L(ayuda, estudiantes, "Consulta")
Rel_U(reportes, usuarios, "Actualiza perfil")
Rel_D(usuarios, estudiantes, "Actualiza perfil")


Rel_D(usuarios, core, "Usa")
Rel_D(core, bd, "SQL", "SQLAlchemy")



SHOW_LEGEND()
@enduml